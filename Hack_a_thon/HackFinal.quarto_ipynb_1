        "\n",
        "## Loading Packages"
      ],
      "id": "6531e8b5"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.impute import SimpleImputer, KNNImputer\n",
        "from sklearn.preprocessing import OneHotEncoder, StandardScaler, PowerTransformer\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.model_selection import cross_val_score, GridSearchCV, RepeatedStratifiedKFold\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "from sklearn.ensemble import RandomForestClassifier"
      ],
      "id": "d671dc8b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "greenfin_train = pd.read_csv(\"greenfin_train.csv\")\n",
        "X_test = pd.read_csv(\"greenfin_test.csv\")\n",
        "original_test_data = pd.read_csv(\"greenfin_test.csv\")\n",
        "\n",
        "X_train = greenfin_train.drop(columns = ['loan_outcome'])\n",
        "y_train = greenfin_train['loan_outcome']"
      ],
      "id": "a96bd9c7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Data Cleaning\n",
        "\n",
        "* I dropped the ID columns since they were not needed.\n",
        "* I added a year obligation over annual income to see how much money per year was already going to previous obligations.\n",
        "* I added a late payment over num credit lines to see if people who added lots of credit lines also paid late."
      ],
      "id": "f81420b2"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "X_train['year_debt_to_income_no_loan'] = X_train['monthly_obligations'] * 12 / X_train['annual_income']\n",
        "X_test['year_debt_to_income_no_loan'] = X_test['monthly_obligations'] * 12 / X_test['annual_income']\n",
        "\n",
        "X_train['late_payments_per_line'] =  X_train['num_late_payments'] / X_train['num_credit_lines']\n",
        "X_test['late_payments_per_line'] =  X_test['num_late_payments'] / X_test['num_credit_lines']\n",
        "\n",
        "X_train = X_train.drop(columns = ['loan_id'])\n",
        "X_test = X_test.drop(columns = ['loan_id'])"
      ],
      "id": "130d3eda",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Preprocessing\n",
        "\n",
        "* I wanted to see if there were any skewed values so I could use a Yeo-Johnson transformation on them, which makes the data a normal distribution.\n",
        "* I picked mean for my simpleimputer because I ran my entire process and mean gave me the quickest and best accuracy.\n",
        "* I ran a simple impute just in case for the cat variables and then a onehotencode because there were only regular categorical (no ordinal) variables."
      ],
      "id": "33aa67a7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "cat = [\n",
        "    'home_ownership',\n",
        "    'loan_purpose',\n",
        "    'state_region'\n",
        "]\n",
        "skew = ['year_debt_to_income_no_loan', 'num_late_payments', 'annual_income', 'loan_amount', 'late_payments_per_line']\n",
        "num = ['debt_to_income', 'num_credit_lines', 'employment_years', 'has_mortgage', 'monthly_obligations',\n",
        "       'age', 'credit_score', 'loan_term_months']\n",
        "skew_values = X_train[num].skew().sort_values(ascending=False)\n",
        "\n",
        "\n",
        "num_transformer = Pipeline([\n",
        "    ('imputer', KNNImputer(n_neighbors=5)),\n",
        "    ('scaler', StandardScaler())\n",
        "])\n",
        "\n",
        "skew_transformer = Pipeline([\n",
        "    ('imputer', SimpleImputer(strategy = 'median')),\n",
        "    ('yeo_johnson', PowerTransformer(method = 'yeo-johnson'))\n",
        "])\n",
        "\n",
        "cat_transformer = Pipeline([\n",
        "    ('imputer', SimpleImputer(strategy = 'constant', fill_value='missing')),\n",
        "    ('onehot', OneHotEncoder(handle_unknown = 'ignore'))\n",
        "])\n",
        "\n",
        "preprocessor = ColumnTransformer([\n",
        "    ('num', num_transformer, num),\n",
        "    ('skew', skew_transformer, skew),\n",
        "    ('cat', cat_transformer, cat)\n",
        "])"
      ],
      "id": "8fd40e02",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Model Fit\n",
        "\n",
        "* I used a 5-fold cross-validation strategy repeated 3 times which made sure that each class was represented proportionally.\n",
        "* I tried to run logisticregression, knnclassifier, and randomforestclassifier but I ultimately chose randomforest because it was significantly better.\n",
        "* The final model was tuned by optimizing the number of trees, the max depth, and the number of features of each split."
      ],
      "id": "2546562e"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "final_rf_model = RandomForestClassifier(\n",
        "    n_estimators=200,\n",
        "    max_depth=None,  \n",
        "    max_features=3,\n",
        "    random_state=4025\n",
        ")\n",
        "\n",
        "rf_pipeline = Pipeline([\n",
        "    ('preprocessor', preprocessor),\n",
        "    ('rf', final_rf_model)\n",
        "])"
      ],
      "id": "f1a4b657",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "rf_pipeline.fit(X_train, y_train)"
      ],
      "id": "2e5ae0f7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Generation Prediction"
      ],
      "id": "39cb7d24"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "predictions = rf_pipeline.predict(X_test)\n",
        "\n",
        "submission = pd.DataFrame({\n",
        "    \"loan_id\": original_test_data[\"loan_id\"],\n",
        "    \"loan_outcome\": predictions\n",
        "})\n",
        "\n",
        "submission.to_csv(\"my_predictions.csv\", index=False)"
      ],
      "id": "6edb5cbf",
      "execution_count": null,
      "outputs": []
    }
